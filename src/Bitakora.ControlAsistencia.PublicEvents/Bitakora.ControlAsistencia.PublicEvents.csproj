<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Sin ProjectReference a proposito: es la condicion para empaquetar este
       ensamblado como NuGet y que un consumidor externo no reciba eventos
       internos del bounded context. -->
  <ItemGroup>
    <PackageReference Include="Cosmos.EventDriven.Abstractions" Version="2.3.1" />
  </ItemGroup>

</Project>
